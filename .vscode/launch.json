{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ladit aktuální soubor",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "justMyCode": true,
      "env": { "PYTHONUTF8": "1" }
    }
  ]
}
